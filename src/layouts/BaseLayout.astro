---
import "../styles/tokens.css"
import "../styles/global.css"
import logoUrl from "../assets/VinnyQF.svg?url";
import faviconUrl from "../assets/favicon.svg?url";
interface Props {
  title: string;
  description: string;
}

const {title, description} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---


<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href={`${faviconUrl}?v=2`} />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description}>
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const systemTheme = window.matchMedia("(prefers-color-scheme: light)");
    
        let savedTheme = null;
    
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          // The theme still works when browser storage is unavailable.
        }
    
        if (savedTheme !== "light" && savedTheme !== "dark") {
          savedTheme = null;
        }
    
        function applyTheme(theme) {
          root.dataset.theme = theme;
    
          const button = document.getElementById("theme-toggle");
    
          if (button) {
            const label =
              theme === "dark"
                ? "Switch to light mode"
                : "Switch to dark mode";
    
            button.setAttribute("aria-label", label);
            button.title = label;
          }
        }
    
        applyTheme(
          savedTheme ?? (systemTheme.matches ? "light" : "dark")
        );
    
        document.addEventListener("DOMContentLoaded", () => {
          const button = document.getElementById("theme-toggle");
    
          if (!button) return;
    
          applyTheme(root.dataset.theme);
          button.hidden = false;
    
          button.addEventListener("click", () => {
            savedTheme =
              root.dataset.theme === "dark" ? "light" : "dark";
    
            applyTheme(savedTheme);
    
            try {
              localStorage.setItem("theme", savedTheme);
            } catch {
              // The selected theme remains active for this page.
            }
          });
        });
    
        systemTheme.addEventListener("change", (event) => {
          if (savedTheme === null) {
            applyTheme(event.matches ? "light" : "dark");
          }
        });
      })();
    </script>


</head>
<body>
    <header class="site-header">
      <div class="site-header__inner">
          <a
            class="site-logo"
            href="/"
            aria-label="Vinícius Fonseca — Home"
          >
              <span
                class="site-logo__mark"
                style={{ "--logo-url": `url("${logoUrl}")` }}
                aria-hidden="true"
              ></span>
          </a>
    
        <nav class="primary-nav" aria-label="Primary navigation">
          <a
            href="/"
            aria-current={pathname === "/" ? "page" : undefined}
          >
            Home
          </a>
    
          <a
            href="/about"
            aria-current={pathname === "/about" ? "page" : undefined}
          >
            About
          </a>
        </nav>

        <div class="header-actions">
          <button
            id="theme-toggle"
            class="header-action"
            type="button"
            aria-label="Switch to light mode"
            title="Switch to light mode"
            hidden
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        
          <button
            class="header-action"
            type="button"
            aria-label="Switch language (coming soon)"
            title="Language switching — coming soon"
            disabled
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <ellipse cx="12" cy="12" rx="4" ry="9" />
              <path d="M3 12h18" />
            </svg>
          </button>
        </div>

    
      </div>
    </header>
    <slot>
    </slot>
</body>
</html>
