---
import "../styles/tokens.css"
import "../styles/global.css"
import logoUrl from "../assets/VinnyQF.svg?url";
import faviconUrl from "../assets/favicon.svg?url";
import { ui, type Locale } from "../i18n/ui";
interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const {
  title,
  description,
  locale = "en",
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const pagePath =
  pathname.replace(/^\/pt-br(?=\/|$)/, "") || "/";

const homeUrl = locale === "en" ? "/" : "/pt-br/";
const aboutUrl = locale === "en" ? "/about" : "/pt-br/about";

const alternateLocale = locale === "en" ? "pt-br" : "en";

const alternateUrl =
  locale === "en"
    ? `/pt-br${pagePath === "/" ? "/" : pagePath}`
    : pagePath;

const labels = ui[locale];
---


<!DOCTYPE html>
<html lang={locale === "pt-br" ? "pt-BR" : "en"}>
<head>
    <link rel="icon" type="image/svg+xml" href={`${faviconUrl}?v=2`} />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description}>
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const systemTheme = window.matchMedia("(prefers-color-scheme: light)");
    
        let savedTheme = null;
    
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          // The theme still works when browser storage is unavailable.
        }
    
        if (savedTheme !== "light" && savedTheme !== "dark") {
          savedTheme = null;
        }
    
        function applyTheme(theme) {
          root.dataset.theme = theme;
    
          const button = document.getElementById("theme-toggle");
    
          if (button) {
            const label =
              theme === "dark"
                ? button.dataset.lightLabel
                : button.dataset.darkLabel;
    
            if (label) {
              button.setAttribute("aria-label", label);
              button.title = label;
            }
          }
        }
    
        applyTheme(
          savedTheme ?? (systemTheme.matches ? "light" : "dark")
        );
    
        document.addEventListener("DOMContentLoaded", () => {
          const button = document.getElementById("theme-toggle");
    
          if (!button) return;
    
          applyTheme(root.dataset.theme);
          button.hidden = false;
    
          button.addEventListener("click", () => {
            savedTheme =
              root.dataset.theme === "dark" ? "light" : "dark";
    
            applyTheme(savedTheme);
    
            try {
              localStorage.setItem("theme", savedTheme);
            } catch {
              // The selected theme remains active for this page.
            }
          });
        });
    
        systemTheme.addEventListener("change", (event) => {
          if (savedTheme === null) {
            applyTheme(event.matches ? "light" : "dark");
          }
        });
      })();
    </script>


</head>
<body>
    <header class="site-header">
      <div class="site-header__inner">
          <a
            class="site-logo"
            href={homeUrl}
            aria-label={`Vinícius Fonseca — ${labels.home}`}
          >
              <span
                class="site-logo__mark"
                style={{ "--logo-url": `url("${logoUrl}")` }}
                aria-hidden="true"
              ></span>
          </a>
    
          <nav class="primary-nav" aria-label={labels.navigation}>
            <a
              href={homeUrl}
              aria-current={pagePath === "/" ? "page" : undefined}
            >
              {labels.home}
            </a>
          
            <a
              href={aboutUrl}
              aria-current={pagePath === "/about" ? "page" : undefined}
            >
              {labels.about}
            </a>
          </nav>

        <div class="header-actions">
          <button
            id="theme-toggle"
            class="header-action"
            type="button"
            aria-label={labels.lightMode}
            title={labels.lightMode}
            data-light-label={labels.lightMode}
            data-dark-label={labels.darkMode}
            hidden
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        
          <a
            class="language-switch"
            href={alternateUrl}
            hreflang={alternateLocale}
            lang={alternateLocale === "pt-br" ? "pt-BR" : "en"}
            aria-label={labels.switchLanguage}
            title={labels.switchLanguage}
          >
            <span
              class:list={[
                "language-switch__option",
                { "is-current": locale === "en" },
              ]}
              lang="en"
              aria-hidden="true"
            >
              EN
            </span>
          
            <span
              class:list={[
                "language-switch__option",
                { "is-current": locale === "pt-br" },
              ]}
              lang="pt-BR"
              aria-hidden="true"
            >
              PT-BR
            </span>
          </a>
        </div>

    
      </div>
    </header>
    <slot>
    </slot>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>© {new Date().getFullYear()} Vinícius Queiroz Fonseca</p>
    
        <a href="https://github.com/VinnyQF/web-portifolio">
          {labels.source}
        </a>
    
        <p>{labels.privacy}</p>
      </div>
    </footer>

</body>
</html>
