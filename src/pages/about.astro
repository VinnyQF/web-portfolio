---
import BaseLayout from "../layouts/BaseLayout.astro";
import {Image} from "astro:assets";
import portrait from "../assets/PFP2.jpg";
---
<BaseLayout title= "Vinícius Fonseca - Developer" description = "I am a developer based in Brazil. Currently, I'm acting as a team member at Seafoam Labs">
    <main>
        <section class="about-intro" aria-labelledby="intro-heading">
          <Image
            class="about-intro__portrait"
            src={portrait}
            alt="Portrait of Vinícius Fonseca"
            width={320}
            densities={[1, 2]}
          />
        
          <div class="about-intro__content">
            <p class="about-intro__eyebrow">About me</p>
          
            <div class="about-intro__bio">
              <h1 id="intro-heading">Vinícius Fonseca</h1>
          
              <p class="about-intro__lead">
                  I’m based in Salvador, Brazil, and enjoy understanding how software works beneath the interface. 
                  Linux gives me plenty of opportunities to explore that curiosity, from package management to the desktop itself.
              </p>

              <p class="about-intro__lead">
                  Contributing to open-source projects helps me learn through practical problems, code review, and collaboration. 
                 
              </p>

            </div>
          
            <ul class="about-intro__contact" aria-label="Contact and profiles">
              <li>
                <a
                  class="contact-link"
                  href="https://github.com/VinnyQF"
                  aria-label="Vinícius Fonseca on GitHub"
                  title="GitHub"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M12 .297c-6.63 0-12 5.373-12 12
                         0 5.303 3.438 9.8 8.205 11.385
                         .6.113.82-.258.82-.577
                         0-.285-.01-1.04-.015-2.04
                         -3.338.724-4.042-1.61-4.042-1.61
                         -.546-1.387-1.335-1.756-1.335-1.756
                         -1.087-.744.084-.729.084-.729
                         1.205.084 1.838 1.236 1.838 1.236
                         1.07 1.835 2.809 1.305 3.495.998
                         .108-.776.418-1.305.762-1.605
                         -2.665-.3-5.466-1.332-5.466-5.93
                         0-1.31.465-2.38 1.235-3.22
                         -.135-.303-.54-1.523.105-3.176
                         0 0 1.005-.322 3.3 1.23
                         .96-.267 1.98-.399 3-.405
                         1.02.006 2.04.138 3 .405
                         2.28-1.552 3.285-1.23 3.285-1.23
                         .645 1.653.24 2.873.12 3.176
                         .765.84 1.23 1.91 1.23 3.22
                         0 4.61-2.805 5.625-5.475 5.92
                         .42.36.81 1.096.81 2.22
                         0 1.606-.015 2.896-.015 3.286
                         0 .315.21.69.825.57
                         C20.565 22.092 24 17.592 24 12.297
                         c0-6.627-5.373-12-12-12"
                    />
                  </svg>
                </a>
              </li>
            
              <li>
                <a
                  class="contact-link"
                  href="mailto:viniqf@proton.me"
                  aria-label="Email Vinícius Fonseca"
                  title="Email"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="14" />
                    <path d="m3 5 9 7 9-7" />
                  </svg>
                </a>
              </li>
            
              <li>
                <a
                  class="contact-link"
                  href="https://www.linkedin.com/in/viniciusqueirozfonseca/"
                  aria-label="Vinícius Fonseca on LinkedIn"
                  title="LinkedIn"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M20.447 20.452h-3.554v-5.569
                         c0-1.328-.027-3.037-1.852-3.037
                         -1.853 0-2.136 1.445-2.136 2.939
                         v5.667H9.351V9h3.414v1.561h.046
                         c.477-.9 1.637-1.85 3.37-1.85
                         3.601 0 4.267 2.37 4.267 5.455
                         v6.286zM5.337 7.433
                         a2.062 2.062 0 1 1 0-4.124
                         2.062 2.062 0 0 1 0 4.124z
                         M6.813 20.452H3.861V9h2.952v11.452z"
                    />
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </section>

    
      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
            
        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2026-02">2026</time>
            <span aria-hidden="true">—</span>
            Present
          </p>
        
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>Seafoam Labs</h3>
              <p>Team Member</p>
            </header>
        
            <ul>
              <li>Maintain and fix bugs across multiple open-source projects.</li>
              <li>Integrate new solutions into existing codebases.</li>
              <li>Investigate issues, test changes, and propose new features.</li>
            </ul>
          </div>
        </article>

        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2023">2023</time>
            <span aria-hidden="true">—</span>
            <time datetime="2025">2025</time>
          </p>
        
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>SGN Sistemas</h3>
              <p>Software Development Intern</p>
            </header>
        
            <ul>
              <li>Maintained and fixed bugs in a legacy ERP system written in Centura.</li>
              <li>Developed new features for the ERP system.</li>
              <li>Integrated the legacy codebase with more modern systems and tools.</li>
            </ul>
          </div>
        </article>
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
      
        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2021">2021</time> — 2026
          </p>
      
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>Centro Universitário Jorge Amado (UNIJORGE)</h3>
              <p>Bachelor's Degree in Computer Engineering</p>
            </header>
      
          </div>
        </article>
      </section>

    
      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Technologies</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="skills-caption">
          <table class="skills-table">
            <caption id="skills-caption">Languages and tools I work with, and where I have used them.</caption>
            <thead>
              <tr>
                <th scope="col">Area</th>
                <th scope="col">Technologies</th>
                <th scope="col">Where I have used them</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Systems</th>
            
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Technologies</span>
                  <ul class="tag-list" aria-label="Systems technologies">
                    <li class="tag">Zig</li>
                    <li class="tag">C</li>
                    <li class="tag">C#</li>
                    <li class="tag">Python</li>
                  </ul>
                </td>
            
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Where I have used them</span>
                    Used throughout Seafoam Labs projects to write new functionality and unit tests for all of its system level tooling.
                </td>
              </tr>
            
              <tr>
                <th scope="row">Backend</th>
            
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Technologies</span>
                  <ul class="tag-list" aria-label="Backend technologies">
                    <li class="tag">SQL Server</li>
                    <li class="tag">Centura</li>
                    <li class="tag">Python</li>
                  </ul>
                </td>
            
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Where I have used them</span>
                  Used at SGN Sistemas for ERP development, event handling,
                  database queries, and interoperability.
                </td>
              </tr>
              <tr>
                <th scope="row">Web development</th>
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Technologies</span>
                  <ul class="tag-list" aria-label="Web technologies">
                    <li class="tag">Astro</li>
                    <li class="tag">HTML</li>
                    <li class="tag">CSS</li>
                    <li class="tag">JavaScript</li>
                    <li class="tag">TypeScript</li>
                  </ul>
                </td>
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Where I have used them</span>
                  Built this portfolio with static Astro pages, responsive layouts, English and Portuguese translations, and light and dark themes.
                </td>
              </tr>

              <tr>
                <th scope="row">Build and deployment</th>
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Technologies</span>
                  <ul class="tag-list" aria-label="Build and deployment tools">
                    <li class="tag">Node.js</li>
                    <li class="tag">Docker</li>
                    <li class="tag">Docker Compose</li>
                    <li class="tag">Nginx</li>
                    <li class="tag">GitHub Actions</li>
                  </ul>
                </td>
                <td>
                  <span class="skills-table__mobile-label" aria-hidden="true">Where I have used them</span>
                  Used to refresh GitHub repository data, build and serve the site in containers, and run automated checks.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>
    </main>

</BaseLayout>
