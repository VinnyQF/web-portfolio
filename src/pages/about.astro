---
import BaseLayout from "../layouts/BaseLayout.astro";
import {Image} from "astro:assets";
import portrait from "../assets/PFP2.jpg";
---
<BaseLayout title= "Vinícius Fonseca - Developer" description = "I am a developer based in Brazil. Currently, I'm acting as a team member at Seafoam Labs">
    <main>
        <section class="about-intro" aria-labelledby="intro-heading">
          <Image
            class="about-intro__portrait"
            src={portrait}
            alt="Portrait of Vinícius Fonseca"
            width={320}
            densities={[1, 2]}
          />
        
          <div class="about-intro__content">
            <p class="about-intro__eyebrow">About me</p>
          
            <div class="about-intro__bio">
              <h1 id="intro-heading">Vinícius Fonseca</h1>
          
              <p class="about-intro__lead">
                I'm a backend and systems developer based in Salvador, Brazil.
                I contribute to open-source Linux projects at Seafoam Labs,
                working with Zig, GTK, and desktop technologies.
              </p>
            </div>
          
            <ul class="about-intro__contact" aria-label="Contact and profiles">
              <li><a href="https://github.com/VinnyQF">GitHub</a></li>
              <li>
                <a href="https://www.linkedin.com/in/viniciusqueirozfonseca/">
                  LinkedIn
                </a>
              </li>
              <li><a href="mailto:viniqf@proton.me">Email me</a></li>
            </ul>
          </div>
        </section>

    
      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
            
        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2026-02">2026</time>
            <span aria-hidden="true">—</span>
            Present
          </p>
        
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>Seafoam Labs</h3>
              <p>Core contributor</p>
            </header>
        
            <ul>
              <li>Maintain and fix bugs across multiple open-source projects.</li>
              <li>Integrate new solutions into existing codebases.</li>
              <li>Investigate issues, test changes, and propose new features.</li>
            </ul>
          </div>
        </article>

        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2023">2023</time>
            <span aria-hidden="true">—</span>
            <time datetime="2025\">2025</time>
          </p>
        
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>SGN Sistemas</h3>
              <p>Software Development Intern</p>
            </header>
        
            <ul>
              <li>Maintained and fixed bugs in a legacy ERP system written in Centura.</li>
              <li>Developed new features for the ERP system.</li>
              <li>Integrated the legacy codebase with more modern systems and tools.</li>
            </ul>
          </div>
        </article>
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
      
        <article class="experience-entry">
          <p class="experience-entry__period">
            <time datetime="2021">2021</time> — 2026
          </p>
      
          <div class="experience-entry__content">
            <header class="experience-entry__header">
              <h3>Centro Universitário Jorge Amado (UNIJORGE)</h3>
              <p>Bachelor's Degree in Computer Engineering</p>
            </header>
      
          </div>
        </article>
      </section>

    
      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Technologies</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="skills-caption">
          <table class="skills-table">
            <caption id="skills-caption">Languages and tools I work with, and where I have used them.</caption>
            <thead>
              <tr>
                <th scope="col">Area</th>
                <th scope="col">Technologies</th>
                <th scope="col">Where I have used them</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Systems</th>
            
                <td>
                  <ul class="tag-list" aria-label="Systems technologies">
                    <li class="tag">Zig</li>
                    <li class="tag">C</li>
                    <li class="tag">C#</li>
                    <li class="tag">Python</li>
                  </ul>
                </td>
            
                <td>
                    Used throughout Seafoam Labs projects to write new functionality and unit tests for all of its system level tooling.
                </td>
              </tr>
            
              <tr>
                <th scope="row">Backend</th>
            
                <td>
                  <ul class="tag-list" aria-label="Backend technologies">
                    <li class="tag">SQL Server</li>
                    <li class="tag">Centura</li>
                  </ul>
                </td>
            
                <td>
                  Used at SGN Sistemas for ERP development, event handling,
                  database queries, and interoperability.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>
    </main>

</BaseLayout>