---
import BaseLayout from "../layouts/BaseLayout.astro";
import {Image} from "astro:assets";
import portrait from "../assets/PFP2.jpg";
---
<BaseLayout title= "Vinícius Fonseca - Developer" description = "I am a developer based in Salvador, Brazil. Currently, I'm acting as a team member at Seafoam Labs">
    <main>
      <section class="intro" aria-labelledby="intro-heading">
        <div class="intro__text">
          <h1 id="intro-heading">Vinícius Fonseca</h1>
          <p class="intro__lead">Backend developer in Brazil. Linux systems and package management.</p>
        </div>
        <Image src={portrait} alt="Portrait of Vinícius Fonseca" width={320} densities={[1, 2]} />
      </section>
    
      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
            
        <article class="experience-entry">
          <h3>Seafoam Labs</h3>
          <p class="experience-entry__meta">
            Core contributor · <time datetime="2026-02">February 2026</time> - Current
          </p>
          <ul>
            <li>General maintenance and bug fixing across multiple projects.</li>
            <li>Integrated new solutions into existing projects.</li>
            <li>Issue tracking, testing, and requesting new features.</li>
          </ul>
        </article>

        <article class="experience-entry">
          <h3>SGN Sistemas</h3>
          <p class="experience-entry__meta">
            Development Intern · <time datetime="2023">2023</time> - <time datetime="2025">2025</time> 
          </p>
          <ul>
            <li>Maintenance and bug fixing on a legacy ERP system written in Centura.</li>
            <li>Developed new features for that system.</li>
            <li>Integrated the old codebase with more modern solutions.</li>
          </ul>
        </article>

      </section>
    
      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Technologies</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="skills-caption">
          <table class="skills-table">
            <caption id="skills-caption">Languages and tools I work with, and where I have used them.</caption>
            <thead>
              <tr>
                <th scope="col">Area</th>
                <th scope="col">Technologies</th>
                <th scope="col">Where I have used them</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Systems</th>
                <td>
                  <div class="tag-list">
                    <span >Zig,</span>
                    <span >C,</span>
                    <span >C#</span>
                  </div>
                </td>
                <td>Shelly-ALPM: libalpm integration, GTK interfaces, event handling and logging.</td>
              </tr>
              <!-- more rows -->
              <tr>
                <th scope="row">Backend</th>
                <td>
                  <div class="tag-list">
                    <span >SQL Server, </span>
                    <span >Centura</span>
                  </div>
                </td>
                <td>SGN Sistemas: ERP module development, event handling, query construction and interoperability.</td>
              </tr>

            </tbody>
          </table>
        </div>

      </section>
    </main>

</BaseLayout>