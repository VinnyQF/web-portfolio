---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepositoryCard from "../components/RepositoryCard.astro";
---
<BaseLayout title= "Vinícius Fonseca - Developer" description = "I am a developer based in Salvador, Brazil. Currently, I'm acting as a team member at Seafoam Labs">
    <main>        
        <section class="intro" aria-labelledby="intro-heading">
            <div>
                <h2 id="intro-heading">Hi! I'm Vinícius Fonseca</h2>
                <p>Feel free to take a look at the projects I'm contributing to!</p>
            </div>
        </section>
        <section class="project-section" aria-labelledby="projects-heading">
          <h2 id="projects-heading">Projects</h2>
        
          <div class="repo-grid">
              <RepositoryCard
                name="Seafoam-Labs / Shelly-ALPM"
                description="Package manager for Arch-based Linux systems."
                languages={["Zig"]}
                repoUrl="https://github.com/Seafoam-Labs/Shelly-ALPM/"
                contributionsUrl="https://github.com/Seafoam-Labs/Shelly-ALPM/pulls?q=is%3Apr+is%3Amerged+author%3AVinnyQF"
              />
              
              <RepositoryCard
                name="Seafoam-Labs / Aqueous"
                description="Modern Wayland Compositor"
                languages={["Zig"]}
                repoUrl="https://github.com/Seafoam-Labs/Aqueous/"
                contributionsUrl="https://github.com/Seafoam-Labs/Aqueous/pulls?q=is%3Apr+is%3Amerged+author%3AVinnyQF"
              />
              
              <RepositoryCard
                name="Web portfolio"
                description="Personal website"
                languages={["Astro"]}
                repoUrl="https://github.com/VinnyQF/web-portifolio"
              />
          </div>
        </section>
    </main>
</BaseLayout>