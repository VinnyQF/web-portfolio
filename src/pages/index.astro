---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title= "Vinícius Fonseca - Developer" description = "I am a developer based in Salvador, Brazil. Currently, I'm acting as a team member at Seafoam Labs">
    <main>        
        <section class="intro" aria-labelledby="intro-heading">
            <div>
                <h2 id="intro-heading">Hi! I'm Vinícius Fonseca</h2>
                <p>Feel free to take a look at the projects I'm contributing to!</p>
            </div>
        </section>
        <section class="project-section" aria-labelledby="projects-heading">
          <h2 id="projects-heading">Projects</h2>
        
          <div class="repo-grid">
            <article class="repo-card">
              <h3>Seafoam-Labs / Shelly-ALPM</h3>
        
              <p>Package manager for Arch-based Linux systems.</p>
        
              <p class="repo-card__metadata">Primary language: Zig</p>
        
              <div class="repo-card__links">
                <a href="https://github.com/Seafoam-Labs/Shelly-ALPM/">
                  View repository
                </a>
        
                <a href="https://github.com/Seafoam-Labs/Shelly-ALPM/pulls?q=is%3Apr+is%3Amerged+author%3AVinnyQF">
                  Merged pull requests
                </a>
              </div>
            </article>
            <article class="repo-card">
              <h3>Seafoam-Labs / Aqueous</h3>
        
              <p>Modern Wayland Compositor</p>
        
              <p class="repo-card__metadata">Primary language: Zig</p>
        
              <div class="repo-card__links">
                <a href="https://github.com/Seafoam-Labs/Aqueous/">
                  View repository
                </a>
        
                <a href="https://github.com/Seafoam-Labs/Aqueous/pulls?q=is%3Apr+is%3Amerged+author%3AVinnyQF">
                  Merged pull requests
                </a>
              </div>
            </article>

          </div>
        </section>
    </main>
</BaseLayout>