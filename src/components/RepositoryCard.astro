---
import RepositoryBar from "./RepositoryBar.astro";
interface Props {
  name: string;
  description: string;
  repoUrl: string;
  languages?: string[];
  contributionsUrl?: string;
  languageBytes?: Record<string,number>;
}
const { 
  name, 
  description, 
  repoUrl, 
  languageBytes = {}, 
  contributionsUrl 
} = Astro.props;
---
<article class="repo-card">
  <div class="repo-card__body">
    
      <h3>
        <a class="repo-card__title-link" href={repoUrl}>
          {name}
          <span aria-hidden="true">↗</span>
        </a>
      </h3>
    <p class="repo-card__description">{description}</p>
  </div>

  <footer class="repo-card__footer">

      <RepositoryBar languageBytes={languageBytes} />

      {contributionsUrl && (
        <div class="repo-card__links">
          <a href={contributionsUrl}>Merged pull requests ↗</a>
        </div>
      )}

  </footer>
</article>
