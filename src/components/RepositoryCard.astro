---
interface Props {
  name: string;
  description: string;
  repoUrl: string;
  languages?: string[];
  contributionsUrl?: string;
}
const { name, description, repoUrl, languages = [], contributionsUrl } = Astro.props;
---
<article class="repo-card">
  <div class="repo-card__body">
    <h3>{name}</h3>
    <p class="repo-card__description">{description}</p>
  </div>

  <footer class="repo-card__footer">
    {languages.length > 0 && (
      <ul class="repo-card__tags">
        {languages.map((language) => (
          <li class="tag">{language}</li>
        ))}
      </ul>
    )}

    <div class="repo-card__links">
      <a href={repoUrl}>Repository ↗</a>

      {contributionsUrl && (
        <a href={contributionsUrl}>Contributions ↗</a>
      )}
    </div>
  </footer>
</article>
