---
import { ui, type Locale } from "../i18n/ui";
interface Props {
  languageBytes: Record<string, number>;
  locale?: Locale;
}

const { languageBytes, locale = "en" } = Astro.props;
const labels = ui[locale];
const percentageFormatter = new Intl.NumberFormat(
  locale === "pt-br" ? "pt-BR" : "en",
  { minimumFractionDigits: 1, maximumFractionDigits: 1 },
);

const languageColors: Record<string, string> = {
  Zig: "#ec915c",
  C: "#555555",
  "C#": "#178600",
  Astro: "#ff5a03",
  JavaScript: "#f1e05a",
  TypeScript: "#3178c6",
  CSS: "#663399",
  HTML: "#e34c26",
  Python: "#3572a5",
  Shell: "#89e051",
  TeX: "#89a051",
};

const entries = Object.entries(languageBytes)
  .filter(([, bytes]) => Number.isFinite(bytes) && bytes > 0)
  .sort(([, first], [, second]) => second - first);

const total = entries.reduce((sum, [, bytes]) => sum + bytes, 0);

const maxNamedLanguages = 4;

const namedEntries = entries.slice(0, maxNamedLanguages);
const remainingEntries = entries.slice(maxNamedLanguages);

const otherBytes = remainingEntries.reduce(
  (sum, [, bytes]) => sum + bytes,
  0,
);

const displayEntries: [string, number][] = [...namedEntries];

if (otherBytes > 0) {
  displayEntries.push(["Other", otherBytes]);
}

const breakdown = displayEntries.map(([name, bytes]) => ({
  name,
  percentage: (bytes / total) * 100,
  color:
    name === "Other"
      ? "#737980"
      : languageColors[name] ?? "#acb2b5",
}));
---

{breakdown.length > 0 && (
  <div class="language-summary">
    <div class="language-bar" aria-hidden="true">
      {breakdown.map((language) => (
        <span
          style={{
            flexGrow: language.percentage,
            backgroundColor: language.color,
          }}
        />
      ))}
    </div>

    <ul class="language-legend" aria-label={labels.distribution}>
      {breakdown.map((language) => (
        <li>
          <span
            class="language-dot"
            style={{ backgroundColor: language.color }}
            aria-hidden="true"
          />
          <span>
            {language.name === "Other" ? labels.other : language.name}
            {" "}{percentageFormatter.format(language.percentage)}%
          </span>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .language-bar {
    display: flex;
    height: 0.375rem;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .language-bar > span {
    flex-basis: 0;
    min-width: 0;
  }

  .language-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem 0.75rem;
  
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  
    color: var(--muted-text);
    font-size: 0.75rem;
  }


  .language-legend li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .language-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
  }
</style>
