PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Example for the HOST user's crontab, not the container.
# Replace /absolute/path/web-portifolio with the checkout location.
# Uses the host timezone: on a UTC host, Monday at 03:00 UTC.
# Requires flock and Docker access. Prevents overlapping refreshes.
0 3 * * 1 flock -n /absolute/path/web-portifolio/.refresh.lock sh /absolute/path/web-portifolio/scripts/refresh-site.sh >> /absolute/path/web-portifolio/refresh.log 2>&1
